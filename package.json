{
  "name": "datatalks-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ],
    "patchedDependencies": {
      "vitepress@1.6.4": "patches/vitepress@1.6.4.patch"
    }
  },
  "scripts": {
    "sync:course": "tsx scripts/sync-course.ts",
    "update:course": "pnpm sync:course && pnpm test && pnpm build && pnpm validate:build",
    "validate:course": "tsx scripts/validate-course.ts",
    "validate:build": "tsx scripts/validate-course.ts --built",
    "test": "tsx --test scripts/tests/*.test.ts",
    "dev": "tsx scripts/ensure-course.ts && vitepress dev docs",
    "build": "pnpm typecheck && tsx scripts/ensure-course.ts && tsx scripts/validate-course.ts && vitepress build docs",
    "preview": "vitepress preview docs",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.20.5",
    "gray-matter": "^4.0.3",
    "markdown-it": "^14.3.3",
    "markdown-it-mathjax3": "^4.3.2",
    "parse5": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitepress": "^1.6.4",
    "vue": "^3.5.13",
    "vue-tsc": "^3.3.13",
    "wrangler": "4.153.0"
  }
}
